{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "build", "public"]
}
